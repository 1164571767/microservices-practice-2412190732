# 复制为仓库根目录的 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密码。
# MySQL 官方镜像要求 DB_USER 不能是 root，请使用普通业务账号。

# ---- MySQL ----
DB_NAME=petcare
DB_USER=petcare
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- 应用连接 ----
# 容器内通过 Compose 服务名 mysql 访问数据库
DB_HOST=mysql
DB_PORT=3306

# ---- 应用配置 ----
# JWT_SECRET 必须至少 32 字符
JWT_SECRET=replace-with-at-least-32-character-secret
JWT_ISSUER=https://petcare.local
APP_PORT=8080
# 本地演示可匿名浏览 /swagger-ui.html 与 /v3/api-docs；生产保持 false 或直接关闭文档。
OPENAPI_PUBLIC=true

# ---- 可选：首次启动引导管理员（三项都填写才会创建，幂等）----
# 管理员密码仅提供占位值；首次启动前在本地 .env 中填写强随机密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-admin-password
BOOTSTRAP_ADMIN_PHONE=13800000000

# ---- Week 06: independent microservice accounts (merge into existing .env) ----
# Set seven distinct passwords. Initialization runs only on a fresh microservices volume.
SERVICE_TOKEN=replace-with-a-random-internal-secret-of-at-least-32-characters
HTTP_CONNECT_TIMEOUT=PT2S
HTTP_READ_TIMEOUT=PT5S
# Optional for small Docker hosts; images otherwise use their JVM percentage default.
# JAVA_OPTS=-Xms32m -Xmx192m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:ActiveProcessorCount=2 -XX:TieredStopAtLevel=1
IDENTITY_DB_PASSWORD=change-me-identity-database-password
PATIENT_DB_PASSWORD=change-me-patient-database-password
CLINIC_DB_PASSWORD=change-me-clinic-database-password
PHARMACY_DB_PASSWORD=change-me-pharmacy-database-password
BILLING_DB_PASSWORD=change-me-billing-database-password
NOTIFICATION_DB_PASSWORD=change-me-notification-database-password
REPORTING_DB_PASSWORD=change-me-reporting-database-password

# ---- Week 07: Nacos discovery (initialize Nacos before starting applications) ----
# Valid Base64 decoding to at least 32 random bytes; never use this placeholder.
NACOS_AUTH_TOKEN=replace-with-base64-of-at-least-32-random-bytes
NACOS_AUTH_IDENTITY_KEY=replace-with-server-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-server-identity-value
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-your-initialized-nacos-password
NACOS_GROUP=PETCARE_SFY_GROUP
# Empty = default namespace; a custom namespace requires its actual pre-created ID.
NACOS_NAMESPACE=
NACOS_SERVER_ADDR=localhost:8848
NACOS_CONSOLE_PORT=18080
NACOS_CONSOLE_URL=http://127.0.0.1:18080
