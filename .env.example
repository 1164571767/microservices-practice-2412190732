# 复制为仓库根目录的 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实密码。
# MySQL 官方镜像要求 DB_USER 不能是 root，请使用普通业务账号。

# ---- MySQL ----
DB_NAME=petcare
DB_USER=petcare
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- 应用连接 ----
# 容器内通过 Compose 服务名 mysql 访问数据库
DB_HOST=mysql
DB_PORT=3306

# ---- 应用配置 ----
# JWT_SECRET 必须至少 32 字符
JWT_SECRET=replace-with-at-least-32-character-secret
JWT_ISSUER=https://petcare.local
APP_PORT=8080
# 本地演示可匿名浏览 /swagger-ui.html 与 /v3/api-docs；生产保持 false 或直接关闭文档。
OPENAPI_PUBLIC=true

# ---- 可选：首次启动引导管理员（三项都填写才会创建，幂等）----
# 下面的口令仅用于本地演示；任何可被访问的环境都必须改成强随机值。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminPassw0rd!
BOOTSTRAP_ADMIN_PHONE=13800000000
