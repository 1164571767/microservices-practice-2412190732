# 复制为 .env 后填写。.env 已被 gitignore，请勿提交真实凭据。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=petcare
DB_USER=<your-mysql-user>
DB_PASSWORD=<your-mysql-password>

# JWT 签名密钥（必填）：至少 32 个字符，缺失或过短时应用启动即失败（快速失败）。
# 下面的值仅用于本地开发；部署到任何共享环境前请替换为随机生成的长密钥。
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=https://petcare.local

# 可选：首次启动时引导一个管理员账号（幂等，账号已存在则跳过）。
# 创建医生与排班需要管理员权限，按需启用。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminPassw0rd!
BOOTSTRAP_ADMIN_PHONE=13800000000
