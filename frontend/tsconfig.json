{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "resolveJsonModule": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "esModuleInterop": true, "skipLibCheck": true,
    "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
